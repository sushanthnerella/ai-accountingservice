# ==============================================================================
# AI Accounting Intelligence Platform - Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME="Accounting Intelligence Platform"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Security & JWT Tokens
# CAUTION: Generate a secure 64-character random key in production
SECRET_KEY=dev-secret-key-change-in-production-1234567890!@#$%
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=accounting_db
# Set explicitly to override individual variables:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/accounting_db

# Redis & Celery Background Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to true in local development or test if you want tasks to execute synchronously without Redis/Celery:
CELERY_TASK_ALWAYS_EAGER=false

# Multi-Modal LLM & Vision OCR Engine
# Provide at least one API key, or specify an OpenAI-compatible local endpoint (Ollama / vLLM):
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Local Ollama or vLLM example: http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o

# Encrypted Document Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/tmp/accounting_storage
STORAGE_ENCRYPTION_KEY=32-bytes-encryption-key-local-123!

# Optional AWS S3 Storage (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
